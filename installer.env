# The install scripts' own version and what they install. This file is the one place for these values:
# `cargo xtask installer` writes them into install.sh and install.ps1, and `cargo test` fails while the scripts
# differ from it. Every installer version is published once, as install-<version>.sh and .ps1, and never changed;
# install.sh and install.ps1 on the site are copies of the newest. So any change here or in the scripts needs a new
# INSTALLER_VERSION. When and how: docs/developers/testing-and-releasing.md, "Install scripts".
#
# The three versions move independently: the installer, sbx, and the executor (with its adapter). These pins are
# what the installer recommends and installs; nothing enforces them afterwards.
INSTALLER_VERSION=0.0.1
# The sbx release to install, without the v.
SBX=0.3.0
# The executor (and the adapter it runs through) to install after sbx, from the official repository, as
# NAME@VERSION. Empty: the installer installs none, and sbx installs the newest default executor the first time it
# needs one.
EXECUTOR=
ADAPTER=
