# sbx guest kernel requirements, merged on top of the upstream Firecracker CI config by `cargo xtask kernel`.
# The list matches the "guest promises" in the sbx-executor-proto crate docs. Every option here must end up `=y`
# (the build fails otherwise).

# Image root filesystem (read-only).
CONFIG_EROFS_FS=y
# Writable layer: per-sandbox ext2 disk under an overlay.
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_VIRTIO_BLK=y
# Host-guest channel.
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
# Guest init as initramfs, and the mounts it makes.
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_UNIX98_PTYS=y
# Live folder sharing (virtio-fs) for executors that support it.
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
