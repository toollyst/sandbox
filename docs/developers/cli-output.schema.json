{
  "$defs": {
    "AvailableExecutor": {
      "additionalProperties": false,
      "description": "An executor or adapter available from a repository for this host (`executor search`, `adapter search`).",
      "properties": {
        "adapter": {
          "description": "For a VMM package: the adapter that runs it. Null for a self-contained executor.",
          "type": [
            "string",
            "null"
          ]
        },
        "advisory": {
          "description": "The repository's advisory for this version, one line, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "architecture": {
          "description": "Architecture of the bundle (OCI terms).",
          "type": "string"
        },
        "line": {
          "description": "Main version: `version` up to its first `-` or `+` (`1.18.0` for `1.18.0+wick.2`). Without `--all`, only the newest\npatch of each main version is listed.",
          "type": "string"
        },
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "os": {
          "description": "Operating system of the bundle.",
          "type": "string"
        },
        "protocol": {
          "description": "Executor protocol version it speaks. Null for a VMM package (see `adapter`).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "repository": {
          "description": "Repository name.",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 of the bundle, hex.",
          "type": "string"
        },
        "size": {
          "description": "Bundle size in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "url": {
          "description": "Bundle URL.",
          "type": "string"
        },
        "version": {
          "description": "Version.",
          "type": "string"
        },
        "yanked": {
          "default": false,
          "description": "Whether the repository has yanked this version: it is skipped unless asked for by its exact version.",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "version",
        "line",
        "repository",
        "os",
        "architecture",
        "url",
        "sha256",
        "size"
      ],
      "type": "object"
    },
    "Capabilities": {
      "additionalProperties": false,
      "description": "What an executor supports.",
      "properties": {
        "arch": {
          "description": "Guest architecture (OCI terms).",
          "type": "string"
        },
        "custom_kernel": {
          "description": "Whether it can boot a kernel shipped in the image.",
          "type": "boolean"
        },
        "live_share": {
          "description": "Whether it can share host folders live (`-v`, bind).",
          "type": "boolean"
        },
        "name": {
          "description": "Executor name.",
          "type": "string"
        },
        "rootfs_formats": {
          "description": "Root filesystem formats it can attach.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "arch",
        "rootfs_formats",
        "live_share",
        "custom_kernel"
      ],
      "type": "object"
    },
    "ChosenExecutor": {
      "additionalProperties": false,
      "description": "The executor sbx would use (`executor current`, `which`).",
      "properties": {
        "adapter": {
          "description": "For a VMM package: the adapter (`name@version`) that runs it.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Name of the installed executor. Null for a path given with `--executor` or found on PATH.",
          "type": [
            "string",
            "null"
          ]
        },
        "program": {
          "description": "Executable that runs (for a VMM package, its adapter).",
          "type": "string"
        },
        "source": {
          "description": "Where it was chosen from: `--executor`, a `.sbx-executor` file path, the default, or PATH.",
          "type": "string"
        },
        "version": {
          "description": "Version of the installed executor. Null when `name` is null.",
          "type": [
            "string",
            "null"
          ]
        },
        "vmm_dir": {
          "description": "For a VMM package: its directory, passed to the adapter as `SBX_EXECUTOR_VMM_DIR`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source",
        "program"
      ],
      "type": "object"
    },
    "DiskUsage": {
      "additionalProperties": false,
      "description": "One row of `system df`.",
      "properties": {
        "active": {
          "description": "Images some sandbox uses; sandboxes that are running. Always 0 for executors.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "reclaimable": {
          "description": "Bytes `system prune -a` would free: unused images with the layers only they use, stopped sandboxes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "size": {
          "description": "Bytes they take on disk (a sandbox's writable disk counts what it wrote, not its size).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "How many there are (executors count installed executors and adapters).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "description": "`images`, `sandboxes` or `executors`.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "total",
        "active",
        "size",
        "reclaimable"
      ],
      "type": "object"
    },
    "Done": {
      "additionalProperties": false,
      "description": "One sandbox that `stop`, `restart`, `kill` or `rm` acted on.",
      "properties": {
        "id": {
          "description": "Full sandbox ID.",
          "type": "string"
        },
        "target": {
          "description": "The argument as given (name, ID or ID prefix).",
          "type": "string"
        }
      },
      "required": [
        "target",
        "id"
      ],
      "type": "object"
    },
    "ErrorBody": {
      "additionalProperties": false,
      "description": "What went wrong.",
      "properties": {
        "exit_code": {
          "description": "The exit code sbx ends with. Only on the last line, when the whole command failed.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "message": {
          "description": "Human-readable message. Its wording may change.",
          "type": "string"
        },
        "target": {
          "description": "The argument (sandbox or image) this error is about, when a command takes several and this one failed.\nThe others still ran.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "message"
      ],
      "type": "object"
    },
    "ErrorLine": {
      "additionalProperties": false,
      "description": "An error, written to stderr as one line.",
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorBody",
          "description": "The error."
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "description": "Something that changed (`events`).",
      "properties": {
        "action": {
          "description": "Sandbox: `create`, `start`, `stop`, `remove`. Image: `pull`, `prepare`, `untag`, `delete`.",
          "type": "string"
        },
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Details. Sandbox: `image`, `name`; on `stop` also `exit_code` and `error`. Image: `reference` (`pull`,\n`untag`), `rootfs_format` (`prepare`).",
          "type": "object"
        },
        "id": {
          "description": "Sandbox ID or image ID.",
          "type": "string"
        },
        "time": {
          "description": "When it happened (RFC 3339, nanoseconds).",
          "type": "string"
        },
        "type": {
          "description": "`sandbox` or `image`.",
          "type": "string"
        }
      },
      "required": [
        "time",
        "type",
        "action",
        "id",
        "attributes"
      ],
      "type": "object"
    },
    "ExecutorInfo": {
      "additionalProperties": false,
      "description": "The executor sbx would use.",
      "properties": {
        "adapter": {
          "description": "For a VMM package: the adapter (`name@version`) that runs it.",
          "type": [
            "string",
            "null"
          ]
        },
        "capabilities": {
          "anyOf": [
            {
              "$ref": "#/$defs/Capabilities"
            },
            {
              "type": "null"
            }
          ],
          "description": "What it supports. Null if it could not be asked (see `error`)."
        },
        "error": {
          "description": "Why it could not be asked.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "`name@version` of the installed executor that a new sandbox would use, its `--executor` path, or `none`.",
          "type": "string"
        },
        "program": {
          "description": "Executable that would run (for a VMM package, its adapter). Null if none.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "Where it was chosen from: `--executor`, a `.sbx-executor` file path, the default, or PATH. Null if none.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ExecutorRef": {
      "additionalProperties": false,
      "description": "An executor or adapter by name and version (`executor install`, `use`, `rm`, `adapter install`, `adapter rm`).",
      "properties": {
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "version": {
          "description": "Version.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "Exited": {
      "additionalProperties": false,
      "description": "One sandbox that `wait` waited for.",
      "properties": {
        "exit_code": {
          "description": "Exit code of the main process.",
          "format": "int32",
          "type": "integer"
        },
        "id": {
          "description": "Full sandbox ID.",
          "type": "string"
        },
        "target": {
          "description": "The argument as given.",
          "type": "string"
        }
      },
      "required": [
        "target",
        "id",
        "exit_code"
      ],
      "type": "object"
    },
    "Hypervisor": {
      "additionalProperties": false,
      "description": "Virtualization support.",
      "properties": {
        "detail": {
          "description": "What was found, human-readable.",
          "type": "string"
        },
        "usable": {
          "description": "Whether VMs can run.",
          "type": "boolean"
        }
      },
      "required": [
        "usable",
        "detail"
      ],
      "type": "object"
    },
    "Image": {
      "additionalProperties": false,
      "description": "A downloaded image (`images`).",
      "properties": {
        "arch": {
          "description": "Architecture in OCI terms.",
          "type": "string"
        },
        "compressed_size": {
          "description": "Sum of the compressed layer sizes, in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "description": "Image ID.",
          "type": "string"
        },
        "ignored_fields": {
          "description": "Image config fields sbx does not apply.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "prepared": {
          "description": "Root filesystem formats that are prepared.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "references": {
          "description": "Normalized references that point to this image. Empty if none does.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "references",
        "arch",
        "prepared",
        "compressed_size",
        "ignored_fields"
      ],
      "type": "object"
    },
    "Info": {
      "additionalProperties": false,
      "description": "Host and installation diagnostics (`info`).",
      "properties": {
        "arch": {
          "description": "Host architecture (OCI terms).",
          "type": "string"
        },
        "cache_dir": {
          "description": "Cache directory.",
          "type": "string"
        },
        "data_dir": {
          "description": "Data directory.",
          "type": "string"
        },
        "executor": {
          "$ref": "#/$defs/ExecutorInfo",
          "description": "The executor sbx would use."
        },
        "guest_init": {
          "description": "Guest init in use: a path, or `embedded in sbx`.",
          "type": "string"
        },
        "hypervisor": {
          "$ref": "#/$defs/Hypervisor",
          "description": "Whether this host can run VMs."
        },
        "images": {
          "description": "Number of images.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "os": {
          "description": "Host operating system, human-readable.",
          "type": "string"
        },
        "running": {
          "description": "Number of running sandboxes.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "sandboxes": {
          "description": "Number of sandboxes.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "description": "sbx version.",
          "type": "string"
        }
      },
      "required": [
        "version",
        "os",
        "arch",
        "hypervisor",
        "executor",
        "guest_init",
        "data_dir",
        "cache_dir",
        "sandboxes",
        "running",
        "images"
      ],
      "type": "object"
    },
    "InstalledAdapter": {
      "additionalProperties": false,
      "description": "An installed adapter (`executor adapter ls`).",
      "properties": {
        "advisory": {
          "description": "The repository's advisory for this version, one line, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "origin": {
          "description": "The repository it was downloaded from, or `local`. Null if not recorded.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Path of its executable.",
          "type": "string"
        },
        "used_by": {
          "description": "Installed VMM packages (`name@version`) that use an adapter of this name.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "version": {
          "description": "Version.",
          "type": "string"
        },
        "yanked": {
          "default": false,
          "description": "Whether its repository has yanked this version (from the last `executor search` or `install`; it still runs).",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "version",
        "path",
        "used_by"
      ],
      "type": "object"
    },
    "InstalledExecutor": {
      "additionalProperties": false,
      "description": "An installed executor (`executor ls`).",
      "properties": {
        "adapter": {
          "description": "For a VMM package: the adapter that runs it. Null for a self-contained executor.",
          "type": [
            "string",
            "null"
          ]
        },
        "advisory": {
          "description": "The repository's advisory for this version, one line, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "default": {
          "description": "Whether it is the default (`executor use`).",
          "type": "boolean"
        },
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "origin": {
          "description": "The repository it was downloaded from, or `local` (installed with `--from`). Null if installed by an sbx that\ndid not record it.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Path of its executable; for a VMM package, its directory.",
          "type": "string"
        },
        "version": {
          "description": "Version.",
          "type": "string"
        },
        "yanked": {
          "default": false,
          "description": "Whether its repository has yanked this version (from the last `executor search` or `install`; it still runs).",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "version",
        "default",
        "path"
      ],
      "type": "object"
    },
    "LogLine": {
      "additionalProperties": false,
      "description": "A piece of the main process output (`logs`): one line, or the part of a line that had arrived. A line\nwhose `data` does not end with a newline continues in the next `LogLine` of the same stream.",
      "properties": {
        "data": {
          "description": "The bytes, with the trailing newline if the line ended, encoded as `encoding` says.",
          "type": "string"
        },
        "encoding": {
          "description": "`utf-8` if the bytes are valid UTF-8 (`data` is that text), otherwise `base64` (standard alphabet, padded).",
          "type": "string"
        },
        "stream": {
          "description": "`stdout` or `stderr`.",
          "type": "string"
        },
        "time": {
          "description": "When sbx received it (RFC 3339, nanoseconds). Lines that arrived together share a time. Always set by\nsbx 0.2.1 and later; kept nullable for scripts written against 0.2.0's schema.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "stream",
        "data",
        "encoding"
      ],
      "type": "object"
    },
    "Login": {
      "additionalProperties": false,
      "description": "Where `login` saved a registry's credentials.",
      "properties": {
        "location": {
          "description": "The file's path, or the helper program's name.",
          "type": "string"
        },
        "registry": {
          "description": "Registry host (`docker.io` for Docker Hub).",
          "type": "string"
        },
        "stored": {
          "description": "`file` (the `auths` of a Docker or containers credentials file) or `helper` (a `docker-credential-*` program).",
          "type": "string"
        }
      },
      "required": [
        "registry",
        "stored",
        "location"
      ],
      "type": "object"
    },
    "Logout": {
      "additionalProperties": false,
      "description": "What `logout` removed.",
      "properties": {
        "registry": {
          "description": "Registry host.",
          "type": "string"
        },
        "removed": {
          "description": "Whether there were credentials to remove.",
          "type": "boolean"
        }
      },
      "required": [
        "registry",
        "removed"
      ],
      "type": "object"
    },
    "Mount": {
      "additionalProperties": false,
      "description": "A folder shared with the host.",
      "properties": {
        "destination": {
          "description": "Guest path.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MountType",
          "description": "`bind` (live) or `copy` (copied in at start)."
        },
        "readonly": {
          "description": "Read-only in the guest.",
          "type": "boolean"
        },
        "source": {
          "description": "Host path.",
          "type": "string"
        }
      },
      "required": [
        "source",
        "destination",
        "kind",
        "readonly"
      ],
      "type": "object"
    },
    "MountType": {
      "description": "How a folder is shared.",
      "oneOf": [
        {
          "const": "bind",
          "description": "Live share.",
          "type": "string"
        },
        {
          "const": "copy",
          "description": "Copied in when the sandbox starts.",
          "type": "string"
        }
      ]
    },
    "Network": {
      "additionalProperties": false,
      "description": "Network access.",
      "properties": {
        "allow": {
          "description": "`HOST:PORT` rules (`--allow`). Empty for `none`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mode": {
          "$ref": "#/$defs/NetworkMode",
          "description": "`none` or `allow`."
        }
      },
      "required": [
        "mode",
        "allow"
      ],
      "type": "object"
    },
    "NetworkMode": {
      "description": "Network mode (`--network`).",
      "oneOf": [
        {
          "const": "none",
          "description": "No network.",
          "type": "string"
        },
        {
          "const": "allow",
          "description": "Only TCP to the allowed `HOST:PORT`s.",
          "type": "string"
        }
      ]
    },
    "Prepared": {
      "additionalProperties": false,
      "description": "A root filesystem that is ready (`prepare`).",
      "properties": {
        "built": {
          "description": "Whether it was built now (`false`: it already existed).",
          "type": "boolean"
        },
        "id": {
          "description": "Image ID.",
          "type": "string"
        },
        "rootfs_format": {
          "description": "Root filesystem format, e.g. `erofs`.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "rootfs_format",
        "built"
      ],
      "type": "object"
    },
    "Process": {
      "additionalProperties": false,
      "description": "A process to run.",
      "properties": {
        "args": {
          "description": "argv.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cwd": {
          "description": "Working directory in the guest.",
          "type": "string"
        },
        "env": {
          "description": "Environment, `NAME=value`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "user": {
          "description": "User (and group), as `-u` takes it.",
          "type": "string"
        }
      },
      "required": [
        "args",
        "env",
        "cwd",
        "user"
      ],
      "type": "object"
    },
    "PruneReport": {
      "additionalProperties": false,
      "description": "What `system prune` removed.",
      "properties": {
        "images": {
          "description": "IDs of removed images (`-a`).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "layers": {
          "description": "Digests of removed layer blobs.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "leftovers": {
          "description": "Paths of removed leftovers (unfinished pulls and builds, half-removed sandboxes).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reclaimed": {
          "description": "Bytes freed on disk.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sandboxes": {
          "description": "IDs of removed sandboxes.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "sandboxes",
        "images",
        "layers",
        "leftovers",
        "reclaimed"
      ],
      "type": "object"
    },
    "Pruned": {
      "additionalProperties": false,
      "description": "An executor or adapter version that `executor prune` removed, or would remove with `--dry-run`.",
      "properties": {
        "kind": {
          "description": "`executor` or `adapter`.",
          "type": "string"
        },
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "removed": {
          "description": "Whether it was removed (false with `--dry-run`).",
          "type": "boolean"
        },
        "version": {
          "description": "Version.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "version",
        "removed"
      ],
      "type": "object"
    },
    "Pulled": {
      "additionalProperties": false,
      "description": "An image that was downloaded (`pull`).",
      "properties": {
        "arch": {
          "description": "Architecture in OCI terms (`amd64`, `arm64`).",
          "type": "string"
        },
        "id": {
          "description": "Image ID (`sha256:…` of the image config).",
          "type": "string"
        },
        "reference": {
          "description": "Normalized reference, e.g. `docker.io/library/alpine:3.20`.",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "id",
        "arch"
      ],
      "type": "object"
    },
    "Removed": {
      "additionalProperties": false,
      "description": "The result for one image given to `rmi`.",
      "properties": {
        "deleted": {
          "description": "Image ID and layer digests deleted. Empty if only a reference was removed.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "target": {
          "description": "The argument as given.",
          "type": "string"
        },
        "untagged": {
          "description": "References removed.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "target",
        "untagged",
        "deleted"
      ],
      "type": "object"
    },
    "Repository": {
      "additionalProperties": false,
      "description": "An executor repository (`executor repo ls`, `add`, `rm`).",
      "properties": {
        "keys": {
          "description": "minisign public keys that sign its index. Empty for an unsigned repository.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "url": {
          "description": "URL. The index is `<url>/v2/index.json` (or `<url>/index.json` for an old unsigned repository).",
          "type": "string"
        }
      },
      "required": [
        "name",
        "url",
        "keys"
      ],
      "type": "object"
    },
    "Resources": {
      "additionalProperties": false,
      "description": "VM size.",
      "properties": {
        "memory_mib": {
          "description": "Memory in MiB.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "scratch_disk_mib": {
          "description": "Writable disk in MiB.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "vcpus": {
          "description": "vCPUs.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "vcpus",
        "memory_mib",
        "scratch_disk_mib"
      ],
      "type": "object"
    },
    "Sandbox": {
      "additionalProperties": false,
      "description": "A sandbox (`ps`, `inspect`).",
      "properties": {
        "created": {
          "description": "When it was created. Null if the file system does not record it.",
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "description": "Why it stopped, if an error stopped it.",
          "type": [
            "string",
            "null"
          ]
        },
        "exit_code": {
          "description": "Exit code of the main process, once it has exited.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "hostname": {
          "description": "Guest hostname, if set.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Full sandbox ID.",
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/SandboxImage",
          "description": "The image it runs."
        },
        "interactive": {
          "description": "Whether the main process's stdin is open (`-i`).",
          "type": "boolean"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Labels (from the image, then `-l`).",
          "type": "object"
        },
        "mounts": {
          "description": "Folders shared with the host.",
          "items": {
            "$ref": "#/$defs/Mount"
          },
          "type": "array"
        },
        "name": {
          "description": "Name given with `--name`.",
          "type": [
            "string",
            "null"
          ]
        },
        "network": {
          "$ref": "#/$defs/Network",
          "description": "Network access."
        },
        "process": {
          "$ref": "#/$defs/Process",
          "description": "The main process."
        },
        "resources": {
          "$ref": "#/$defs/Resources",
          "description": "VM size."
        },
        "rootfs_format": {
          "description": "Root filesystem format.",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/SandboxState",
          "description": "Lifecycle state."
        },
        "stop": {
          "$ref": "#/$defs/Stop",
          "description": "How `stop` stops it."
        },
        "timeout_secs": {
          "description": "Seconds after each start when sbx stops it (`--timeout`); absent when it runs until stopped.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "tty": {
          "description": "Whether the main process has a terminal (`-t`).",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "state",
        "image",
        "rootfs_format",
        "process",
        "resources",
        "network",
        "mounts",
        "labels",
        "stop",
        "interactive",
        "tty"
      ],
      "type": "object"
    },
    "SandboxImage": {
      "additionalProperties": false,
      "description": "The image a sandbox runs.",
      "properties": {
        "id": {
          "description": "Image ID.",
          "type": "string"
        },
        "reference": {
          "description": "The reference it was pulled as. Null if the image has since been removed.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "SandboxRef": {
      "additionalProperties": false,
      "description": "A sandbox that was created or started (`create`, `run -d`, `start`).",
      "properties": {
        "id": {
          "description": "Full sandbox ID.",
          "type": "string"
        },
        "name": {
          "description": "Name, if it has one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "SandboxState": {
      "description": "Sandbox lifecycle state (OCI names).",
      "oneOf": [
        {
          "const": "creating",
          "description": "Being created.",
          "type": "string"
        },
        {
          "const": "created",
          "description": "Created, not started yet.",
          "type": "string"
        },
        {
          "const": "running",
          "description": "Running.",
          "type": "string"
        },
        {
          "const": "stopped",
          "description": "Stopped.",
          "type": "string"
        }
      ]
    },
    "Stats": {
      "additionalProperties": false,
      "description": "One running sandbox's resource use (`stats`), as its guest reports it.",
      "properties": {
        "cpu_percent": {
          "description": "CPU use over the last second; 100 is one vCPU fully busy (like Docker).",
          "format": "double",
          "type": "number"
        },
        "cpus": {
          "description": "vCPUs.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "disk_total": {
          "description": "Writable disk size, in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "disk_used": {
          "description": "Bytes used on the writable disk.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "description": "Sandbox ID.",
          "type": "string"
        },
        "memory_total": {
          "description": "Memory size, in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "memory_used": {
          "description": "Memory in use, in bytes (total minus available).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "Name, if it has one.",
          "type": [
            "string",
            "null"
          ]
        },
        "pids": {
          "description": "Processes running in the sandbox.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "cpu_percent",
        "cpus",
        "memory_used",
        "memory_total",
        "disk_used",
        "disk_total",
        "pids"
      ],
      "type": "object"
    },
    "Stop": {
      "additionalProperties": false,
      "description": "How `stop` stops a sandbox.",
      "properties": {
        "signal": {
          "description": "Signal sent first, e.g. `SIGTERM`.",
          "type": "string"
        },
        "timeout_secs": {
          "description": "Seconds to wait before powering off. Null: the command's default.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "signal"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sbx --format json output types"
}
